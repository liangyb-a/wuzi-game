page {
  background-color: #fdfeea;
  height: 100%;
}

.home-page {
  min-height: 100vh;
  position: relative;
}

/* stage 高度 = 背景图显示高度（宽 100% * 图片比例 1335/750），
   所有内容相对图片定位，保证在任何机型上按钮都落在图内白区 */
.stage {
  position: relative;
  width: 100%;
}

.bg-img {
  width: 100%;
  display: block;
}

/* 导航栏（图顶部标题区） */
.nav-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28rpx 10rpx;
  box-sizing: border-box;
  z-index: 10;
}
.title-wrap {
  display: flex;
  align-items: center;
}
.title {
  font-size: 54rpx;
  font-weight: bold;
  color: #3e3221;
  letter-spacing: 10rpx;
  text-shadow: 0 2rpx 4rpx rgba(255,255,255,0.6);
}

/* 用户信息卡片 */
.user-card {
  position: absolute;
  top: 190rpx;
  left: 72rpx;
  right: 72rpx;
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.5);
  border-radius: 24rpx;
  padding: 20rpx 26rpx;
  border: 2rpx solid rgba(201,168,108,0.5);
  box-shadow: 0 6rpx 20rpx rgba(92,74,46,0.08);
  z-index: 5;
  box-sizing: border-box;
}
.avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #e6d2b0, #d4bc94);
  border: 4rpx solid #c9a86c;
  margin-right: 24rpx;
  box-shadow: inset 0 0 16rpx rgba(0,0,0,0.08);
}
.user-info {
  flex: 1;
}
.score-line {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}
.score, .record {
  font-size: 28rpx;
  color: #5c4a2e;
  margin-right: 28rpx;
  font-weight: 500;
}
.stars {
  font-size: 26rpx;
  color: #c9a86c;
  letter-spacing: 2rpx;
}

/* 棋盘卡片 */
.board-card {
  position: absolute;
  top: 380rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 686rpx;
  padding: 14rpx;
  background: linear-gradient(145deg, #e6d2b0, #d4bc94);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 48rpx rgba(92,74,46,0.22), inset 0 2rpx 8rpx rgba(255,255,255,0.3);
  border: 4rpx solid #bfa37a;
  box-sizing: border-box;
  z-index: 5;
}
.home-board {
  display: block;
  width: 100%;
  height: 634rpx;
  background-color: #f0d9a6;
  border-radius: 16rpx;
}

/* 底部菜单：定位在背景图下部白色区域内（可按图微调 bottom） */
.menu-grid {
  position: absolute;
  left: 72rpx;
  right: 72rpx;
  bottom: 46rpx;
  display: flex;
  justify-content: space-between;
  background: rgba(255,255,255,0.6);
  border-radius: 28rpx;
  padding: 26rpx 22rpx;
  border: 2rpx solid rgba(201,168,108,0.55);
  box-shadow: 0 6rpx 20rpx rgba(92,74,46,0.1);
  z-index: 5;
  box-sizing: border-box;
}
.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 132rpx;
}
.icon {
  width: 84rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 44rpx;
  margin-bottom: 12rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  border: 2rpx solid rgba(0,0,0,0.04);
}
.icon.ai { background: #fdecea; }
.icon.pvp { background: #eaf4fe; }
.icon.challenge { background: #fff8e6; }
.icon.rules { background: #f0f0f0; }
.label {
  font-size: 24rpx;
  color: #5c4a2e;
  font-weight: 500;
}

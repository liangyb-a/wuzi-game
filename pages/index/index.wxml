<view class="container">
  <view class="toolbar">
    <button class="btn" bindtap="startGame">人人对战</button>
    <button class="btn" bindtap="startAIGame">人机对战</button>
    <button class="btn" bindtap="undo" data-role="undo">悔棋</button>
    <view class="turn">当前：<text>{{currentTurnText}}</text></view>
  </view>

  <view class="board-wrap">
    <canvas type="2d" id="board" bindtouchstart="onCanvasTap"></canvas>
  </view>

  <view class="overlay" wx:if="{{gameOver}}">
    <view class="overlay-box">
      <text class="result">{{winnerText}}</text>
      <button class="btn" bindtap="startGame">重新开始</button>
    </view>
  </view>
</view>
